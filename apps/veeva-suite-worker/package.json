{
  "name": "@agent-x/veeva-suite-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["suite-core"],
  "scripts": {
    "build": "npm run build -w @agent-x/veeva-suite-core && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "npm run typecheck -w @agent-x/veeva-suite-core && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-x/veeva-suite-core": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
