{
  "id": "project_management_pharma",
  "version": 1,
  "module_type": "role_playbook",
  "title": "Project Management (Pharma)",
  "agency_role": "project_management",
  "vertical": "pharma",
  "estimatedMinutes": 120,
  "requires": [{ "playbook_id": "pharma_knowledge", "status": "completed" }],
  "competencies_granted": ["veeva_orientation", "pm_delivery"],
  "missions": [
    {
      "id": "m1_workspace",
      "title": "Workspace setup",
      "steps": [
        {
          "id": "pm_p_s1_workspaces",
          "kind": "workspace_task",
          "title": "Open sandbox project hierarchy",
          "href": "/workspaces",
          "validation": { "type": "manual" }
        },
        {
          "id": "pm_p_s2_scenario",
          "kind": "tool_task",
          "title": "Save a scenario document",
          "href": "/tools/scenario-planner",
          "validation": { "type": "document", "documentKind": "scenario" }
        },
        {
          "id": "pm_p_s3_omni",
          "kind": "tool_task",
          "title": "Save an omnichannel plan",
          "href": "/tools/omnichannel-planner",
          "validation": { "type": "document", "documentKind": "omnichannel_plan" }
        }
      ]
    },
    {
      "id": "m2_launch",
      "title": "Launch and agent",
      "steps": [
        {
          "id": "pm_p_s4_launchpad",
          "kind": "tool_task",
          "title": "Launchpad readiness check",
          "href": "/tools/launchpad",
          "validation": { "type": "memory", "title": "Launchpad learning checkpoint" }
        },
        {
          "id": "pm_p_s5_pm_run",
          "kind": "agent_task",
          "title": "PM breakdown on sandbox",
          "href": "/agents/pm",
          "validation": { "type": "run", "agentKeys": ["pm", "kitt"] }
        },
        {
          "id": "pm_p_s6_veeva",
          "kind": "read",
          "title": "Veeva Suite orientation",
          "href": "/tools/veeva-suite?tab=how",
          "validation": { "type": "manual" }
        },
        {
          "id": "pm_p_s7_capstone",
          "kind": "workspace_task",
          "title": "Capstone: review project items",
          "href": "/workspaces",
          "validation": { "type": "manual" }
        }
      ]
    }
  ]
}
