APP_ENV=local
PROJECT_NAME=dd-agent-suite

# --- Observability (optional Compose profile) ---
# docker compose --profile observability up -d
# Grafana UI: http://localhost:3001 (web-dashboard stays on 3000). Prometheus: http://localhost:9090
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin

# Next.js: rewrites proxy /api/* to the API. In Docker the dashboard image sets this at build time.
# For local `next dev` / `next build` without Docker for the UI, point at a reachable agent-api:
# AGENT_API_URL=http://localhost:8080

DATABASE_URL=postgresql://dd_agent:dd_agent_dev@postgres:5432/dd_agents
REDIS_URL=redis://redis:6379/0

OLLAMA_BASE_URL=http://ollama:11434
# Ollama `num_ctx` (model-router only). Lower values reduce KV-cache RAM; very high values can cause Ollama 500s on small Docker hosts.
# Default 2048 can truncate long PM runs (project registry + memories + user text), hurting JSON quality—try 4096–8192 if you have headroom.
# If you see "degraded" with Ollama memory errors, lower this.
OLLAMA_NUM_CTX=2048
# Primary timeout (seconds) for model-router → Ollama /api/chat and /api/embeddings. Overrides OLLAMA_HTTP_TIMEOUT when set.
# LLM_CHAT_TIMEOUT_SECONDS=240
# model-router: legacy timeout env when LLM_CHAT_TIMEOUT_SECONDS is unset (default 240 in code).
# OLLAMA_HTTP_TIMEOUT=240
# model-router: bounded retries for Ollama 5xx chat only (default 0).
# OLLAMA_CHAT_RETRIES=0
# model-router: second chat without JSON schema when first parse fails (default off).
# PM_SCHEMA_FALLBACK=0
# model-router: after structured chat hits Ollama 5xx / transport error, retry once without grammar (docker-compose default 1).
# OLLAMA_GRAMMAR_FAILURE_FALLBACK=1
# model-router GET /v1/models “runnable” probes — POST /api/chat or /api/embeddings ping per model (extra CPU vs agent runs).
# docker-compose.yml pins OLLAMA_PROBE_CHAT default to 0 on model-router; override here to re-enable live probes.
# When 0: Models UI “runnable” follows tag presence only (see docs/local_llm.md).
OLLAMA_PROBE_CHAT=0
# OLLAMA_PROBE_TIMEOUT=90
# OLLAMA_PROBE_CACHE_TTL_SEC=90
# Whitespace-only counts as unset (default http://model-router:8085). Compose sets this for agent-api.
MODEL_ROUTER_URL=http://model-router:8085

# agent-api: hypothetical blended cloud USD per 1K tokens (input+output) for “estimated savings” vs local. Unset defaults to 0.00025; set 0 to show $0.00.
# CLOUD_LLM_USD_PER_1K_TOKENS=0.00025

# --- Web search (SearXNG) — outbound metasearch; see docs/agent-lanes.md ---
WEB_SEARCH_ENABLED=1
SEARXNG_URL=http://searxng:8080
SEARXNG_BASE_URL=http://localhost:8888/
SEARXNG_SECRET_KEY=change-me-run-openssl-rand-hex-32
SEARCH_RUNNER_URL=http://search-runner:8092
# WEB_PROXY_SEARCH_TIMEOUT_SEC=30
# MCP profile (optional): docker compose --profile mcp up -d mcp-searxng
MCP_BRIDGE_ENABLED=1
MCP_BRIDGE_TARGETS=mcp-searxng=http://mcp-searxng:3030
# MCP_AUTH_TOKEN=mcp-searxng-dev-token
# MCP_HTTP_ALLOWED_ORIGINS=http://model-router:8085

# HAL9000 (pm): Llama 3.1 8B — no llama3.2:8b tag exists.
DEFAULT_PM_MODEL=llama3.1:8b
# Synergy/Clinic use 3B by default (not inherited from PM).
DEFAULT_SYNERGY_MODEL=llama3.2:3b
DEFAULT_CLINIC_MODEL=llama3.2:3b
# Bot the Builder: Ollama Qwen 2.5 instruct 7B. Highest precedence for that agent.
DEFAULT_BUILDER_MODEL=qwen2.5:7b
# Legacy fallback for builder when DEFAULT_BUILDER_MODEL is unset (e.g. qwen2.5-coder:7b for code-heavy pulls).
DEFAULT_CODE_MODEL=qwen2.5-coder:7b
DEFAULT_CANON_MODEL=llama3.2:3b
DEFAULT_FORGE_MODEL=llama3.2:3b
# KITT / Eddie / Bubs (model-router). Gemma 3 270M needs a recent Ollama (see docs/local_llm.md).
DEFAULT_KITT_MODEL=gemma3:270m
# KITT only: never | auto | always — Ollama JSON-schema format for agent kitt (default never).
# KITT_ROUTER_GRAMMAR_MODE=never
DEFAULT_EDDIE_MODEL=deepseek-r1:1.5b
DEFAULT_BUBS_MODEL=tinyllama:1.1b
DEFAULT_EMBED_MODEL=nomic-embed-text

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-dev-only
ARTIFACT_BUCKET=dd-agent-artifacts
UPLOAD_BUCKET=dd-agent-uploads

WORKSPACE_ROOT=/workspace
ARTIFACT_ROOT=/artifacts
ALLOW_SHELL_COMMANDS=false
ALLOW_REPO_WRITE=false

# Phase 06 queue hardening
RUN_QUEUE=agent.runs
PROCESSING_QUEUE=agent.runs.processing
DEAD_QUEUE=agent.runs.dead
RUN_MAX_ATTEMPTS=2
EMBEDDING_DIM=768
# Phase 10 retrieval playground
RETRIEVAL_V2_ENABLED=1
WEB_DEEPFETCH_RERANKER_ID=colbert_gte_modern
EMBED_AT_INGEST=nomic-embed-text,embeddinggemma
# VPS (~32 GiB RAM): shorten model unload delay in host .env only, e.g. OLLAMA_KEEP_ALIVE=5m
# Extra Ollama embedders (ollama-warm-models.sh, default on)
# EMBED_WARM_GEMMA=1
# EMBED_WARM_MXBAI=1
# EMBED_WARM_BGE=1
# RERANK_OLLAMA_ENABLED=1
RERANK_TEI_TIMEOUT_SEC=30
# ColBERT reranker sidecar (reranker-colbert). ML image needs ~2–4 GB RAM; first boot downloads ~600 MB to reranker_colbert_hf.
# COLBERT_WITH_ML=1
# COLBERT_FORCE_STUB=0
# COLBERT_MODEL=lightonai/GTE-ModernColBERT-v1
# Optional run input (JSON): "skip_memory_embed": true — agent-worker skips POST /v1/embed for that run (keyword memory only).
# agent-worker: Redis TTL (seconds) for cached COUNT of embedded chunks per project (0=disabled). Cuts repeat COUNTs when polling runs.
# CHUNK_COUNT_CACHE_TTL_SEC=0
# agent-worker → model-router: send schema_key instead of full JSON schema (smaller /v1/route bodies). Requires model-router vendor schemas (Docker image copies schemas.py).
# docker-compose.yml pins default to 1 on agent-worker; set 0 to force inline schema (e.g. dev router without vendor).
MODEL_ROUTER_SCHEMA_KEY=1
# agent-worker: skip /v1/embed for hybrid memory (keyword-only). 1=enabled (default).
# HYBRID_MEMORY_EMBED=1
# agent-worker: Redis cache for embeddings (requires REDIS_URL). TTL in seconds.
# EMBED_CACHE_ENABLED=1
# EMBED_CACHE_TTL_SEC=120
# agent-worker: explicit timeout for POST /v1/route (optional; default = LLM_CHAT_TIMEOUT_SECONDS + margin).
# MODEL_ROUTER_HTTP_TIMEOUT_SEC=
# MODEL_ROUTER_HTTP_TIMEOUT_MARGIN_SEC=60

# Monitoring: probe multiple agent-worker replicas explicitly (comma-separated).
# If unset, agent-api uses AGENT_WORKER_URL only (see docker-compose agent-api).
# AGENT_WORKER_URLS=http://agent-worker:8091,http://agent-worker:8091
# When using a single URL but multiple replicas (DNS RR), repeat health probes to surface hostnames:
# AGENT_WORKER_HEALTH_SAMPLES=4

# Optional: same pattern for ingestion-worker /health (comma-separated).
# INGESTION_WORKER_URLS=http://ingestion-worker:8092

# scenario-worker: monitoring probes only (comma-separated); default single URL from docker-compose SCENARIO_WORKER_URL.
# SCENARIO_WORKER_URL=http://scenario-worker:8093
# SCENARIO_WORKER_URLS=http://scenario-worker:8093

# PROCESSING_QUEUE reconciliation (agent-api background task)
# PROCESSING_RECONCILE_ENABLED=1
# PROCESSING_RECONCILE_INTERVAL_SEC=120
# PROCESSING_RECONCILE_BATCH=80
# Multi agent-api replica: Redis NX lock so only one instance runs reconcile per interval (see docs/scaling.md).
# PROCESSING_RECONCILE_LOCK_KEY=agentx:processing_reconcile:leader
# PROCESSING_RECONCILE_LOCK_TTL_SEC=90

# Ingest processing-list reconcile (agent-api; use with INGEST_REDIS_RELIABLE on ingestion-worker)
# INGEST_PROCESSING_RECONCILE_ENABLED=1
# INGEST_PROCESSING_RECONCILE_BATCH=80
# INGEST_PROCESSING_RECONCILE_LOCK_KEY=agentx:ingest_processing_reconcile:leader
# INGEST_PROCESSING_RECONCILE_LOCK_TTL_SEC=90

# ingestion-worker: BRPOPLPUSH buffer + same-queue name on agent-api (defaults match docker-compose)
# INGEST_REDIS_RELIABLE=0
# DOCUMENT_INGEST_PROCESSING_QUEUE=document.ingest.processing

# Optional DB pool (agent-worker) — reduces connection churn when scaling replicas
# WORKER_DB_POOL_ENABLED=1
# WORKER_DB_POOL_MIN=1
# WORKER_DB_POOL_MAX=8

# Optional DB pool (ingestion-worker)
# INGEST_DB_POOL_ENABLED=1
# INGEST_DB_POOL_MIN=1
# INGEST_DB_POOL_MAX=4

# ingestion-worker timeline CSV: skip LLM phase mapping; use string fallback only (fast local dev).
# TIMELINE_MAP_MODE=fallback_only

# model-router: uvicorn worker processes (single container)
# UVICORN_WORKERS=1

# --- Keycloak + web-dashboard auth (docker-compose sets KEYCLOAK_* on web-dashboard) ---
# Keycloak admin UI: http://localhost:8180 (override host port with KEYCLOAK_HOST_PORT).
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=change-me
# KEYCLOAK_REALM=platform
# KEYCLOAK_CLIENT_ID=web-dashboard
# KEYCLOAK_CLIENT_SECRET=web-dashboard-dev-secret
# Never set KEYCLOAK_CLIENT_SECRET= with no value — Docker Compose passes empty string and breaks login.
# Dev user from realm import: operator / operator-dev-password (change in Keycloak UI for real use).
#
# Local Next.js without Docker: point at Keycloak on the host, e.g. KEYCLOAK_BASE_URL=http://127.0.0.1:8180
# KEYCLOAK_BASE_URL=http://keycloak:8080
#
# Disable all auth (trusted dev only — set both for consistent UI):
# AUTH_DISABLED=1
# NEXT_PUBLIC_AUTH_DISABLED=1
#
# Optional JWT issuer override if tokens use a different iss than KEYCLOAK_BASE_URL/realms/KEYCLOAK_REALM
# KEYCLOAK_ISSUER=https://auth.example.com/realms/platform
#
# Optional cookie max-age fallback (seconds) when JWT has no exp
# AUTH_COOKIE_MAX_AGE_SEC=43200
# Optional: force Secure session cookies (default: Secure only on HTTPS / X-Forwarded-Proto: https)
# AUTH_COOKIE_SECURE=1
#
# Production: do NOT set NEXT_PUBLIC_AGENT_API_URL if you need the /api proxy auth gate.

# --- Brief templates & Brief ops ---
# agent-api: when set, draft GET/PUT/PATCH/Publish/Bootstrap require matching header `x-brief-ops-token` from clients.
# BRIEF_OPS_TOKEN=
# web-dashboard: optional; forwarded as x-brief-ops-token when calling brief-template APIs through the Next proxy (dev only unless you accept exposing a token to the browser).
# NEXT_PUBLIC_BRIEF_OPS_TOKEN=
# Hide Brief ops nav link (build-time): NEXT_PUBLIC_SHOW_BRIEF_OPS=0
# agent-api: max characters of document chunk text for POST /api/brief/autofill-from-document (default 16000, min 4000).
# BRIEF_AUTOFILL_MAX_CHARS=16000

# --- Veeva Suite (Tools → agent-api `/api/veeva-suite/*` → veeva-suite-worker) ---
# agent-api: internal worker URL (Compose default matches docker-compose.yml).
# VEEVA_SUITE_WORKER_URL=http://veeva-suite-worker:4317
# agent-api: proxy timeout seconds for ZIP extract + optional Playwright (default 600).
# VEEVA_SUITE_PROXY_TIMEOUT_SEC=600
# veeva-suite-worker (Compose): browser URL prefix embedded in generated HTML (must match agent-api `/api/veeva-suite`).
# WEB_PATH_PREFIX=/api/veeva-suite
# veeva-suite-worker: Playwright visits this base + `/outputs/{id}/...` (inside container; default worker loopback).
# VEEVA_SUITE_PUBLIC_OUTPUT_BASE_URL=http://127.0.0.1:4317
# veeva-suite-worker: set true only if the worker image includes Playwright Chromium (default off in compose).
# VEEVA_SUITE_ENABLE_SCREENSHOTS=false

# --- Learning (Tools → Learning, 9th catalog entry) ---
# agent-api: manager Team tab + /api/learning/ops/summary (default off).
# LEARNING_OPS_OPEN=1
# agent-api: skip playbook prerequisite checks (dev).
# LEARNING_GATES_DISABLED=1
# web-dashboard: hide competency gate banners (build-time).
# NEXT_PUBLIC_LEARNING_GATES_DISABLED=1
